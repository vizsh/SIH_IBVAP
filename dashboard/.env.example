# Local dev: leave unset. Vite's dev-server proxy (vite.config.ts) rewrites
# /api/* to http://127.0.0.1:8000 automatically, no configuration needed.
#
# Production (Vercel): set this to the deployed backend's origin, e.g.
#   VITE_API_URL=https://ibvap-backend.onrender.com
# The frontend then calls that origin's root paths directly (/events,
# /audit, /telemetry, /ws) — no proxy exists between two separately
# hosted services, so this must be the backend's real public URL.
VITE_API_URL=
